[worldserver]

########################################
# mod-madosa Configuration
########################################
#
# The values below are only the install-time defaults. A GM can change every
# one of them - except Madosa.Addon.Enable, see below - at any time, with no
# server restart, either with the ".madosa" chat commands (".madosa status" /
# ".madosa set <key> <value>" / ".madosa reset <key>") or from the
# MadosaControl client addon (see modules/mod-madosa/addon/MadosaControl).
# Changes are stored in the mod_madosa_settings world DB table and survive
# restarts; ".madosa reset <key>" reverts a setting back to the value
# configured here.
#
# Each setting has a shorter runtime key used by ".madosa set/reset" and by the
# addon. For the on/off toggles it is the config name lowercased without the
# "Madosa." prefix (Madosa.InstanceQuestPet.Enable -> instancequestpet.enable);
# the numeric settings use abbreviated names:
#
#     Madosa.ProfessionXP.PercentOfLevelXP    -> professionxp.percent
#     Madosa.ProfessionXP.SkillGainMultiplier -> professionxp.skillmultiplier
#     Madosa.ProfessionSlots.Max              -> professionslots.max
#     Madosa.PasserbyBuff.Radius              -> passerbybuff.radius
#
# ".madosa status" always prints the authoritative list. Keep the ".enable"
# suffix for new on/off toggles - MadosaControl renders a checkbox for those
# and an input box for everything else.
#

# Madosa.ProfessionXP.Enable
#
#        Description: Grant XP for every gather/craft attempt (mining, herbalism, skinning,
#                     lockpicking, jewelcrafting, inscription, any crafting profession, fishing)
#                     that still has a chance to raise the skill - not only the ones that
#                     actually roll a skill point, since e.g. a "green" recipe/node can still be
#                     crafted/gathered many times before it turns grey. Stops on its own once the
#                     skill is grey or capped - nothing to tune there, that's how the underlying
#                     skill-up roll already works.
#
#        Default:     1 - Enabled
#                     0 - Disabled
#
Madosa.ProfessionXP.Enable = 1

# Madosa.ProfessionXP.PercentOfLevelXP
#
#        Description: XP awarded per gather/craft attempt, as a percentage of the XP required to
#                     go from the player's current level to the next one. Scales with level so
#                     it stays similarly meaningful early and late instead of becoming
#                     negligible at high level or overpowered at low level.
#
#        Default:     1.0 (each attempt grants 1% of the current level's XP requirement)
#
Madosa.ProfessionXP.PercentOfLevelXP = 1.0

# Madosa.ProfessionXP.SkillGainMultiplier
#
#        Description: Multiplies how many skill points an actual skill-up grants, for every
#                     profession - primary (mining, herbalism, skinning, blacksmithing, etc.) and
#                     secondary (cooking, first aid, fishing, lockpicking) alike. Independent of
#                     the XP settings above; a value of 1 leaves skill-up amounts untouched.
#
#        Default:     2 (each skill-up grants 2 skill points instead of 1)
#
Madosa.ProfessionXP.SkillGainMultiplier = 2

# Madosa.ProfessionTools.Enable
#
#        Description: Hands a player the matching gathering tool (Mining Pick, Skinning
#                     Knife, Fishing Pole) the moment they know that profession - whether
#                     they just trained it or already knew it before this was enabled.
#                     Only touches gathering professions that actually use a tool; skipped
#                     entirely if they already have one.
#
#        Default:     1 - Enabled
#                     0 - Disabled
#
Madosa.ProfessionTools.Enable = 1

# Madosa.AutoLootPet.Enable
#
#        Description: While a player has the "Lootbot" companion (sold for 1000g by the
#                     Special Vendor in every capital city) summoned, their kills auto-loot
#                     everything they'd be allowed to take themselves - items still under a
#                     pending need/greed roll are left for the player to handle normally.
#
#        Default:     1 - Enabled
#                     0 - Disabled
#
Madosa.AutoLootPet.Enable = 1

# Madosa.AccountCompanions.Enable
#
#        Description: Makes the companion pets (Lootbot, Classtrainer, Craftbot, Bankbot,
#                     Auctionbot) account-wide - once any character on the account has
#                     learned one, every other character on that account knows it too
#                     from their next login on, no extra purchase needed.
#
#        Default:     1 - Enabled
#                     0 - Disabled
#
Madosa.AccountCompanions.Enable = 1

# Madosa.InstanceQuestPet.Enable
#
#        Description: While summoned inside a dungeon or raid, Questbot offers every quest
#                     that instance has (skipping the usual level/prerequisite-chain gate -
#                     the actual accept still runs the normal check, so a quest that truly
#                     isn't takeable yet still gets rejected the normal way). From anywhere,
#                     it takes back any instance quest currently in your log.
#
#        Default:     1 - Enabled
#                     0 - Disabled
#
Madosa.InstanceQuestPet.Enable = 1

# Madosa.ProfessionSlots.Enable
#
#        Description: Enables the "Scroll of Professions" (item 90001). Consuming one
#                     grants the character a further primary profession slot, on top of
#                     the server's MaxPrimaryTradeSkill. How many scrolls a character
#                     has used is kept in the mod_madosa_profession_slots table and
#                     re-applied on every login, because WotLK derives the free-slot
#                     counter from scratch each time instead of storing it.
#
#        Default:     1 - Enabled
#                     0 - Disabled
#
Madosa.ProfessionSlots.Enable = 1

# Madosa.ProfessionSlots.Max
#
#        Description: Upper limit for the total number of primary professions a single
#                     character may end up with, scrolls included. Further scrolls
#                     refuse to be consumed once it is reached. Values at or below the
#                     server's MaxPrimaryTradeSkill make the scroll a no-op.
#
#        Default:     5
#
Madosa.ProfessionSlots.Max = 5

# Madosa.PasserbyBuff.Enable
#
#        Description: Idle/random playerbots that are NOT in your group give you their
#                     signature buff when they're standing nearby, the way a friendly
#                     player might in trade chat. Only Priest (Fortitude/Divine Spirit),
#                     Mage (Arcane Intellect), Druid (Mark of the Wild) and Paladin
#                     (a Blessing) have anything to offer this way - every other class's
#                     buffs (Battle Shout, Aspects, Auras, totems) only ever affect the
#                     caster's own party/raid in WotLK, so bystanders can't receive them.
#                     A bot only offers the highest rank it actually knows for its level,
#                     never re-casts a buff you already have, and always waits for a
#                     grouped bot's own party-buff behavior instead of interfering with it.
#
#        Default:     1 - Enabled
#                     0 - Disabled
#
Madosa.PasserbyBuff.Enable = 1

# Madosa.PasserbyBuff.Radius
#
#        Description: How close (in yards) an eligible bot must be standing to buff you.
#                     Checked every 5 seconds, so this doesn't need to be large - a bot
#                     that walked past and out of range simply gets picked up again next
#                     time it (or another one) comes close enough.
#
#        Default:     20
#
Madosa.PasserbyBuff.Radius = 20

# Madosa.PasserbyBuff.Priest.Fortitude.Enable
# Madosa.PasserbyBuff.Priest.Spirit.Enable
# Madosa.PasserbyBuff.Mage.Intellect.Enable
# Madosa.PasserbyBuff.Druid.MarkOfTheWild.Enable
# Madosa.PasserbyBuff.Paladin.Kings.Enable
# Madosa.PasserbyBuff.Paladin.Wisdom.Enable
# Madosa.PasserbyBuff.Paladin.Might.Enable
#
#        Description: Per-buff toggles, so a passerby buff can be turned off individually
#                     (e.g. only Fortitude, not Divine Spirit). Paladin blessings share one
#                     aura slot on the target, so only the highest-priority enabled blessing
#                     (Kings, then Wisdom, then Might) is ever offered by a given bot - the
#                     other two stay disabled toggles rather than fighting over the slot.
#
#        Default:     1 - Enabled (all seven)
#                     0 - Disabled
#
Madosa.PasserbyBuff.Priest.Fortitude.Enable = 1
Madosa.PasserbyBuff.Priest.Spirit.Enable = 1
Madosa.PasserbyBuff.Mage.Intellect.Enable = 1
Madosa.PasserbyBuff.Druid.MarkOfTheWild.Enable = 1
Madosa.PasserbyBuff.Paladin.Kings.Enable = 1
Madosa.PasserbyBuff.Paladin.Wisdom.Enable = 1
Madosa.PasserbyBuff.Paladin.Might.Enable = 1

# Madosa.RepairPet.Enable
#
#        Description: Repairbot, a companion pet (2000g, sold by the same Special
#                     Vendor NPCs as the other companions) that repairs everything
#                     you carry from anywhere. Normal repair costs still apply, so
#                     this removes the walk back to town, not the gold sink.
#
#        Default:     1 - Enabled
#                     0 - Disabled
#
Madosa.RepairPet.Enable = 1

# Madosa.MailPet.Enable
#
#        Description: Mailbot, a companion pet (2000g, same vendors) that opens your
#                     mailbox from anywhere.
#
#        Default:     1 - Enabled
#                     0 - Disabled
#
Madosa.MailPet.Enable = 1

# Madosa.OmniPet.Enable
#
#        Description: Omnibot, a companion pet (10000g, sold by the same Special
#                     Vendor NPCs) offering every service the individual companions
#                     do - bank, auction house, mail, repair and training - and
#                     auto-looting your kills like Lootbot. It exists because WotLK
#                     allows only ONE summoned companion at a time, so owning eight
#                     service pets means constantly swapping them.
#
#        Default:     1 - Enabled
#                     0 - Disabled
#
Madosa.OmniPet.Enable = 1

# Madosa.Worldforged.Enable
#
#        Description: Worldforged. Every so often the server forges a "Worldforged
#                     Cache" at one of the spots in mod_madosa_worldforged_spawns,
#                     announces the zone to everyone online, and whoever gets there
#                     first opens it for a randomly enchanted piece of gear scaled
#                     to their own level, plus some gold. Only real players can open
#                     one - on a realm with thousands of playerbots the event would
#                     otherwise never reach a person.
#
#                     A cache is only forged while at least one real player is
#                     online, and its spot is chosen to suit one of their levels.
#
#        Default:     1 - Enabled
#                     0 - Disabled
#
Madosa.Worldforged.Enable = 1

# Madosa.Worldforged.Announce
#
#        Description: Announce to every online player when a cache is forged (naming
#                     its zone, never its exact spot - finding it is the point), when
#                     one is claimed, and when one crumbles away unclaimed. With this
#                     off the event still runs, but only whoever stumbles over a cache
#                     will ever know about it.
#
#        Default:     1 - Enabled
#                     0 - Disabled
#
Madosa.Worldforged.Announce = 1

# Madosa.Worldforged.IntervalMinutes
#
#        Description: Minutes between forge attempts. An attempt that finds nobody
#                     online waits out the full interval again rather than retrying,
#                     so this is the pace of the event whether or not anyone is there.
#
#        Default:     20
#
Madosa.Worldforged.IntervalMinutes = 20

# Madosa.Worldforged.LifetimeMinutes
#
#        Description: How long a cache stands before it crumbles away. Give players
#                     enough time to cross a continent - much below the travel time
#                     of your realm and the announcement becomes a tease.
#
#        Default:     30
#
Madosa.Worldforged.LifetimeMinutes = 30

# Madosa.Worldforged.MaxActive
#
#        Description: How many caches may stand at once. Each one keeps the map grid
#                     it spawned in resident for the rest of the uptime (this core
#                     never unloads grids at runtime), so raise this only if your
#                     realm has the players to chase them.
#
#        Default:     1
#
Madosa.Worldforged.MaxActive = 1

# Madosa.Worldforged.RareChance
#
#        Description: Percent chance that a cache holds a rare (blue) item instead of
#                     an uncommon (green) one. Below level 20 there are no forgeable
#                     blues in WotLK's item data, so a roll that early falls back to
#                     a green either way.
#
#        Default:     15
#
Madosa.Worldforged.RareChance = 15

# Madosa.Worldforged.GoldPerLevel
#
#        Description: Copper per character level handed out alongside the item, varied
#                     by +/-20%. At the default a level 80 character finds around 4
#                     gold. Set to 0 for no money at all.
#
#        Default:     500
#
Madosa.Worldforged.GoldPerLevel = 500

# Madosa.Addon.Enable
#
#        Description: Lets the MadosaControl client addon read and change the
#                     settings above over the addon (self-whisper) channel.
#                     Every request still requires the "Command: madosa" RBAC
#                     permission (see data/sql/db-auth/base/madosa_settings_rbac.sql) -
#                     this only turns the bridge itself on or off. Disabling
#                     it does not affect the ".madosa" chat commands.
#
#                     Deliberately NOT runtime-tunable: it gates the very
#                     channel MadosaControl talks through, so switching it off
#                     from the panel would lock the panel out. Change it here
#                     and restart, or use the ".madosa" chat commands.
#
#        Default:     1 - Enabled
#                     0 - Disabled
#
Madosa.Addon.Enable = 1
